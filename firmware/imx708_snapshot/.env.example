# Modo local (sin Raspberry): Mosquitto corriendo en esta PC.
TAPITAS_MQTT_HOST=localhost
# Modo con Raspberry: poner la IP de la Pi en vez de localhost.
# TAPITAS_MQTT_HOST=192.168.1.100

# Opcionales -- estos son los defaults, solo hace falta descomentar y cambiar
# si el umbral se ajusta en tapitas_ingest.py o si Ollama corre en otro host/modelo.
# TAPITAS_UMBRAL_ROTA=0.20
# TAPITAS_CONFIANZA_MINIMA=0.50
# TAPITAS_OLLAMA_HOST=http://localhost:11434
# TAPITAS_OLLAMA_MODEL=qwen2.5vl:3b   (alternativa mas rapida: llava-phi3)
# Segunda opinion para tapitas dudosas: "gemini" (API, con Ollama de respaldo
# si no hay internet) u "ollama" (solo local). Sin GEMINI_API_KEY usa ollama.
# GEMINI_API_KEY=tu_clave_de_ai_studio
# TAPITAS_IA=gemini
# TAPITAS_GEMINI_MODEL=gemini-3.1-flash-lite
# Color por IA para cada tapita, solo con Gemini (1 = si, 0 = solo el color del ESP32).
# TAPITAS_COLOR_IA=1

# Puerto serial del ESP32. Si no existe, el script usa el primer /dev/ttyACM*
# TAPITAS_SERIAL_PORT=/dev/ttyACM0

# SCADA: segundos que tarda la cinta real en llevar algo de punta a punta
# (velocidad de la animacion). Subirlo si la cinta del SCADA va mas rapido.
# TAPITAS_SCADA_CRUCE_S=40
